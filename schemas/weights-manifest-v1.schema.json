{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:main-protocol:schema:weights-manifest:v1",
  "title": "Main Protocol Weights Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "datasetId",
    "chainId",
    "datasetRegistry",
    "leafEncoding",
    "pairHashing",
    "totalWeight",
    "weightsRoot",
    "entries",
    "pipeline"
  ],
  "properties": {
    "schema": { "const": "main-protocol.weights-manifest.v1" },
    "datasetId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "chainId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "datasetRegistry": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "leafEncoding": { "const": "keccak256(abi.encode(address,uint256))" },
    "pairHashing": { "const": "sorted-keccak256;promote-unpaired" },
    "totalWeight": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "weightsRoot": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "weight", "proof"],
        "properties": {
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "weight": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "proof": {
            "type": "array",
            "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "contentDigest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "contentDigest": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    }
  }
}
