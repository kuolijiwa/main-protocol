{
  "name": "main-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat --coverage test",
    "gas": "hardhat --gas-stats test",
    "typecheck": "tsc --noEmit",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:contributor-registry": "hardhat test test/unit/ContributorRegistry.ts",
    "test:protocol-config": "hardhat test test/unit/ProtocolConfig.ts",
    "test:dataset-registry": "hardhat test test/unit/DatasetRegistry.ts",
    "test:entitlement-nft": "hardhat test test/unit/EntitlementNFT.ts",
    "test:revenue-splitter": "hardhat test test/unit/RevenueSplitter.ts",
    "test:marketplace": "hardhat test test/integration/Marketplace.ts",
    "deploy": "hardhat run scripts/deploy.ts",
    "verify:deployment": "hardhat run scripts/verify-deployment.ts",
    "validate:allocation": "hardhat run scripts/validate-merkle-allocation.ts",
    "generate:weights-manifest": "hardhat run scripts/generate-weights-manifest.ts",
    "verify:weights-manifest": "hardhat run scripts/verify-weights-manifest.ts",
    "validate:challenge-evidence": "hardhat run scripts/validate-weight-challenge-evidence.ts",
    "live:base-sepolia:inspect": "node --env-file=.env scripts/base-sepolia/inspect.mjs",
    "live:base-sepolia:admin": "node --env-file=.env scripts/base-sepolia/admin.mjs",
    "live:base-sepolia:setup-test-accounts": "node --env-file=.env scripts/base-sepolia/setup-test-accounts.mjs",
    "live:base-sepolia:timelock": "node --env-file=.env scripts/base-sepolia/timelock.mjs",
    "live:base-sepolia:contributor": "node --env-file=.env scripts/base-sepolia/contributor.mjs",
    "live:base-sepolia:operator": "node --env-file=.env scripts/base-sepolia/operator.mjs",
    "live:base-sepolia:buyer": "node --env-file=.env scripts/base-sepolia/buyer.mjs",
    "live:base-sepolia:claimant": "node --env-file=.env scripts/base-sepolia/claimant.mjs",
    "live:base-sepolia:treasury": "node --env-file=.env scripts/base-sepolia/treasury.mjs",
    "live:base-sepolia:gateway": "node --env-file=.env scripts/base-sepolia/gateway.mjs",
    "live:base-sepolia:all": "node --env-file=.env scripts/base-sepolia/run-all.mjs",
    "audit:deps": "npm audit --audit-level=high --registry=https://registry.npmjs.org && npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org",
    "ci": "npm run format:check && npm run lint:sol && npm run typecheck && npm run audit:deps && ALLOCATION_FILE=test-vectors/allocation.json npm run validate:allocation && npm run coverage",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/hardhat-upgrades": "4.1.0",
    "@safe-global/safe-smart-account": "1.5.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "latest",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.13.0",
    "mocha": "11.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-solidity": "2.4.1",
    "solhint": "6.2.4",
    "typescript": "latest"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "glob": "10.5.0",
      "serialize-javascript": "7.1.0"
    }
  }
}
