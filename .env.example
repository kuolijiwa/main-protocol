# Select one configured persistent network and keep secrets only in an untracked .env file.
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Chain and externally deployed dependency pins.
EXPECTED_CHAIN_ID=
EIP1153_CONFIRMED=false
PAYMENT_TOKEN=
PAYMENT_TOKEN_CODE_HASH=
PAYMENT_TOKEN_DECIMALS=
ADMIN_MULTISIG=
ADMIN_MULTISIG_CODE_HASH=
ADMIN_MULTISIG_OWNERS=
ADMIN_MULTISIG_THRESHOLD=
ADMIN_MULTISIG_SINGLETON=
ADMIN_MULTISIG_SINGLETON_CODE_HASH=
# Set these to the exact reviewed addresses; use the zero address when intentionally disabled.
ADMIN_MULTISIG_GUARD=0x0000000000000000000000000000000000000000
ADMIN_MULTISIG_FALLBACK_HANDLER=0x0000000000000000000000000000000000000000

# Main Protocol initial configuration.
TREASURY=
GATEWAY_SIGNER=
NURTURE_CONTRIBUTOR=
PIPELINE_OPERATOR=
FEE_BPS=
CHALLENGE_WINDOW_SECONDS=

# Fill these from scripts/deploy.ts output before post-deployment verification.
PROTOCOL_TIMELOCK=
PROTOCOL_TIMELOCK_CODE_HASH=
CONTRIBUTOR_REGISTRY=
CONTRIBUTOR_REGISTRY_CODE_HASH=
PROTOCOL_CONFIG=
PROTOCOL_CONFIG_CODE_HASH=
DATASET_REGISTRY=
DATASET_REGISTRY_CODE_HASH=
ENTITLEMENT_NFT=
ENTITLEMENT_NFT_CODE_HASH=
REVENUE_SPLITTER=
REVENUE_SPLITTER_PROXY_CODE_HASH=
MARKETPLACE=
MARKETPLACE_PROXY_CODE_HASH=
MARKETPLACE_IMPLEMENTATION=
MARKETPLACE_IMPLEMENTATION_CODE_HASH=
REVENUE_SPLITTER_IMPLEMENTATION=
REVENUE_SPLITTER_IMPLEMENTATION_CODE_HASH=
DEPLOYER_ADDRESS=

# Local Hardhat simulation only. Never enable on a persistent network.
ALLOW_EOA_ADMIN=false
# Temporary Base Sepolia test-only override. Requires ALLOW_EOA_ADMIN=true and must be removed before production.
ALLOW_EOA_ADMIN_ON_BASE_SEPOLIA_TEST=false

# Optional public gateway used by verify:weights-manifest for ipfs:// URIs.
IPFS_GATEWAY_URL=

# Pipeline Manifest generation and independent verification inputs.
ALLOCATION_FILE=
PIPELINE_VERSION=
GENERATED_AT=
CONTENT_DIGEST=
MANIFEST_OUTPUT_FILE=

# Off-chain challenge evidence validation inputs.
EVIDENCE_FILE=
EVIDENCE_URI=
WEIGHTS_ROOT=
EXPECTED_EVIDENCE_HASH=
